public class ArrayQueue<T> implements QueueInterface<T> {
    private T[] elements = (T[]) new Object[4];
    private int size;
    private int head = 0;
    private int tail = 0;
    int size;    
    
    // tests if this queue is empty
    public boolean empty(){
        return size == 0;
    }
    
    // adds an item onto the rear of this queue
    public T add(T item){
        if(size == elements.length){
            T[] newElements = (T[]) new Object[elements.length*2];
            for (int i = 0; i < size; i++) {
                newElements[i] = elements[(head + i) % elements.length];
            }
            head = 0;
            tail = size-1;
        }

        if(tail = elements.length-1){
            tail = 0
        } else{
            tail++;
        }

          elements[tail] = item;
        size++;
        return item;
    }
        
    // looks at the object at the front of this queue
    // without removing it from the queue
    public T peek() throws QueueUnderflowException{
        if (empty())
        {
            throw new QueueUnderflowException("Stack is empty");
        }
        return elements[head];
    }
    
    // removes the object at the front of this queue 
    // and returns that object as the value of this function
    public T remove() throws QueueUnderflowException{
        T item = elements[head];
         elements[head] = null;

        if(head<elements.length-1){
            head++;
        } else{
            head = 0;
        }
        size--;
        if (size <= elements.length / 4 && elements.length > 4)
        {
            T[] newElements = (T[]) new Object[elements.length / 2];
            for (int i = 0; i < size; i++) {
                newElements[i] = elements[(head + i) % elements.length];
            }
            elements = newElements;
            head = 0;
            tail = size-1;
        }
        return item;
    }
    
    // removes all of the elements from this stack
    public void clear(){
        elements = (T[]) new Object[4];
        size = 0;
    }

    public boolean isFull(){
        return size == elements.length;
    }
}